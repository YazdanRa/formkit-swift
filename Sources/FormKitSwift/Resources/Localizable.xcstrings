    "Type declarations must be strings or nullable primitive unions.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Type declarations must be strings or nullable primitive unions."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las declaraciones de tipo deben ser cadenas o uniones de tipos primitivos que admitan valores nulos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les déclarations de type doivent être des chaînes ou des unions de types primitifs acceptant la valeur null."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A típusdeklarációknak karakterláncoknak vagy null értéket engedélyező primitív unióknak kell lenniük."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le dichiarazioni di tipo devono essere stringhe o unioni di tipi primitivi nullable."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deklaracje typów muszą być ciągami znaków albo uniami typów prostych dopuszczającymi wartość null."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As declarações de tipo devem ser strings ou uniões de tipos primitivos anuláveis."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Объявления типов должны быть строками или объединениями примитивных типов с поддержкой null."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Deklarácie typov musia byť reťazce alebo zjednotenia primitívnych typov s možnosťou hodnoty null."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tür tanımları dize veya null olabilen temel tür birleşimleri olmalıdır."
          }
        }
      }
    },
    "Union types are only supported for nullable primitives.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Union types are only supported for nullable primitives."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los tipos de unión solo se admiten para tipos primitivos que admitan valores nulos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les types union ne sont pris en charge que pour les types primitifs acceptant la valeur null."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az uniótípusok csak null értéket engedélyező primitív típusoknál támogatottak."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I tipi unione sono supportati solo per i tipi primitivi nullable."
          }
        },
