    "Array rendering requires a single supported items schema.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Array rendering requires a single supported items schema."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La representación de arrays requiere un único esquema de elementos compatible."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le rendu d’un tableau nécessite un seul schéma d’éléments pris en charge."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A tömb megjelenítéséhez egyetlen támogatott elemséma szükséges."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il rendering dell’array richiede un unico schema degli elementi supportato."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Renderowanie tablicy wymaga jednego obsługiwanego schematu elementów."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A renderização do array requer um único esquema de itens compatível."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для отображения массива требуется одна поддерживаемая схема элементов."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vykreslenie poľa vyžaduje jednu podporovanú schému položiek."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dizinin işlenmesi, desteklenen tek bir öğe şeması gerektirir."
          }
        }
      }
    },
    "Array schemas must declare a single items schema.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Array schemas must declare a single items schema."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los esquemas de tipo array deben declarar un único esquema de elementos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les schémas de type tableau doivent déclarer un seul schéma d’éléments."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A tömbsémáknak egyetlen elemsémát kell megadniuk."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli schemi di array devono dichiarare un unico schema degli elementi."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Schematy tablic muszą deklarować jeden schemat elementów."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os esquemas de array devem declarar um único esquema de itens."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В схеме массива должна быть объявлена одна схема элементов."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Schémy polí musia deklarovať jednu schému položiek."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dizi şemaları tek bir öğe şeması tanımlamalıdır."
          }
        }
      }
    },
